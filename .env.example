# Template only: every value stays empty. Copy to .env.local and fill in keys there.
# MOCK by default (empty). Set AEI_LIVE=true to enable real Meta API calls.
AEI_LIVE=
# Director provider (empty = muse-spark): muse-spark | muse-spark-open
AEI_DIRECTOR_PROVIDER=
# Server-side only. Never commit real keys — they go ONLY in .env.local (gitignored).
MODEL_API_KEY=
# Fallback alias for MODEL_API_KEY (either works).
META_API_KEY=
BASETEN_API_KEY=
# M5 track pre-analysis (Modal DSP, compute only). Unset = live analysis only.
MODAL_ANALYZE_URL=
MODAL_ANALYZE_TOKEN=
