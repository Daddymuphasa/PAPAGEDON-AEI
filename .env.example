# MOCK by default. Set true to enable real Meta API calls (M7 demo).
AEI_LIVE=false
# Director provider: muse-spark | muse-spark-open
AEI_DIRECTOR_PROVIDER=muse-spark
# Server-side only. Never commit real keys.
MODEL_API_KEY=
# Fallback alias for MODEL_API_KEY (either works).
META_API_KEY=
BASETEN_API_KEY=
# M5 track pre-analysis (Modal DSP, compute only). Unset = live analysis only.
MODAL_ANALYZE_URL=
MODAL_ANALYZE_TOKEN=
